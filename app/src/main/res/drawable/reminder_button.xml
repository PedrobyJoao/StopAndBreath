<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#182C2923">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape>
                    <solid android:color="#18FFFCF5" />
                    <stroke android:width="1dp"
                        android:color="#77736A" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="#66FFFCF5" />
                    <stroke android:width="1dp"
                        android:color="@color/reminder_ink" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
